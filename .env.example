# maktaba — environment variables
# Copy to .env and fill in. Every value below is OPTIONAL: the app has a working
# default for each one. Never commit the filled-in .env.
#
# Secrets (the OpenRouter API key and the gateway token) are NOT read from here.
# They are entered in the UI and stored on disk in openrouter-key.json and
# gateway-token.json, both of which .gitignore keeps out of the repository.

# HTTP port for the server (default 4500)
PORT=

# Absolute path to the ACP delegate script used for AI repairs.
# Leave empty to resolve it from config.json, a sibling checkout, or PATH.
ACP_DELEGATE_PATH=

# --- storage locations (leave empty to use the repository folder) ---
MAKTABA_DB=
MAKTABA_DB_JSON=
MAKTABA_LOGS_DIR=
MAKTABA_ACTION_LOG=
MAKTABA_CATALOGUE_BACKUPS=
MAKTABA_RESTORE_LEDGER=
MAKTABA_GATEWAY_TOKEN=
MAKTABA_GATEWAY_USAGE=
MAKTABA_MODEL_SCORES=
MAKTABA_MODEL_HEALTH=
MAKTABA_MODEL_AVAILABILITY=

# --- guardian script overrides (tools/maktaba-guardian.ps1) ---
MAKTABA_ROOT=
MAKTABA_NODE=
